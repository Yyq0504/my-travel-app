.material-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.keyword-tag {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 10rpx 20rpx;
  background-color: #fff;
  border-radius: 50rpx;
  display: inline-block;
}

.material-info {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.material-info .title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 10rpx;
}

.material-info .desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.img-item {
  width: calc(33.33% - 10rpx);
  border-radius: 12rpx;
  overflow: hidden;
}

.img-item image {
  width: 100%;
  height: 200rpx;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn.submit {
  background-color: #07c160;
  color: #fff;
  border: none;
}

.btn.lottery {
  background-color: #ff6700;
  color: #fff;
  border: none;
}