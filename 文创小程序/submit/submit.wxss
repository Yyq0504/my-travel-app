page{background:#f7f8fa;}
.page{padding:40rpx 32rpx;}
.title{font-size:42rpx;font-weight:600;margin-bottom:12rpx;}
.desc{font-size:26rpx;color:#888;margin-bottom:40rpx;}

.upload-section{margin-bottom:40rpx;}
.upload-box{width:100%;height:360rpx;background:#fff;border-radius:20rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.placeholder{color:#999;font-size:28rpx;}
.preview{width:100%;height:100%;}

.form-item{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:24rpx;}
input,textarea{font-size:28rpx;}
textarea{height:160rpx;}

.submit-btn{background:#5c6fff;color:#fff;border-radius:16rpx;margin-top:20rpx;}